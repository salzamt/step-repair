#!/usr/bin/env bash
set -euo pipefail


usage() {
    echo "Usage:"
    echo "  run-repair <input.stp|input.step>"
    echo "  run-repair --stl <input.stp|input.step>"
}


STL_MODE=0

if [[ "${1:-}" == "--stl" ]]; then
    STL_MODE=1
    shift
fi


if [[ $# -ne 1 ]]; then
    usage >&2
    exit 2
fi


SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPAIR_SCRIPT="$SCRIPT_DIR/repair_step.py"


if [[ ! -f "$REPAIR_SCRIPT" ]]; then
    echo "ERROR: repair_step.py not found:" >&2
    echo "  $REPAIR_SCRIPT" >&2
    exit 1
fi


INPUT="$(realpath -- "$1")"


if [[ ! -f "$INPUT" ]]; then
    echo "ERROR: input file does not exist:" >&2
    echo "  $INPUT" >&2
    exit 1
fi


DIR="$(dirname -- "$INPUT")"
FILE="$(basename -- "$INPUT")"


if [[ "$FILE" == *.* ]]; then
    STEM="${FILE%.*}"
    EXT="${FILE##*.}"
    OUTPUT="$DIR/${STEM}_repaired.${EXT}"
else
    STEM="$FILE"
    OUTPUT="$DIR/${FILE}_repaired.stp"
fi


echo "Input: $INPUT"

if [[ "$STL_MODE" -eq 1 ]]; then
    echo "Mode:  STL multi-part"
else
    echo "Mode:  STEP"
    echo "Output: $OUTPUT"
fi

echo


export REPAIR_SCRIPT
export REPAIR_INPUT="$INPUT"
export REPAIR_OUTPUT="$OUTPUT"
export REPAIR_STL_MODE="$STL_MODE"


flatpak run \
    --env=REPAIR_SCRIPT="$REPAIR_SCRIPT" \
    --env=REPAIR_INPUT="$REPAIR_INPUT" \
    --env=REPAIR_OUTPUT="$REPAIR_OUTPUT" \
    --env=REPAIR_STL_MODE="$REPAIR_STL_MODE" \
    --command=FreeCADCmd \
    org.freecad.FreeCAD <<'EOF'
import os
import sys

script = os.environ["REPAIR_SCRIPT"]
input_file = os.environ["REPAIR_INPUT"]
output_file = os.environ["REPAIR_OUTPUT"]
stl_mode = os.environ["REPAIR_STL_MODE"] == "1"

sys.argv = [script]

if stl_mode:
    sys.argv.append("--stl")

sys.argv.extend([
    input_file,
    output_file,
])

exec(
    compile(
        open(script).read(),
        script,
        "exec",
    )
)
EOF
